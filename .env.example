# Local mode works without Google Cloud access.
STORAGE_MODE=local
DATABASE_MODE=memory
AI_MODE=mock

# Google Cloud mode
GOOGLE_CLOUD_PROJECT=claimflow-ai-agents
GOOGLE_CLOUD_LOCATION=australia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=true

# Planned Google Cloud resources
FIRESTORE_DATABASE_ID=(default)
DOCUMENT_BUCKET=claimflow-ai-agents-documents

# Optional stretch-goal integration
ELEVENLABS_API_KEY=

# Runtime
HOST=0.0.0.0
PORT=8080
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Serve the built React app from Fastify (same origin).
SERVE_WEB=false
UPLOAD_DIR=uploads

# Vertex extraction (only when AI_MODE=vertex). Storage stays in Sydney.
GEMINI_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global
AI_TIMEOUT_MS=40000

# Optional ElevenLabs clarification (disabled until configured). Never commit real values.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=
# ELEVENLABS_WEBHOOK_SECRET=
# CLARIFICATION_REVIEW_TOKEN= # at least 32 characters
# CLARIFICATION_TEST_PHONE= # E.164 test participant, e.g. +61400000000
